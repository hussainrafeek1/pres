"use client";

import { useState } from "react";

export default function UploadPage() {
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<any>(null);

  const handleUpload = async (e: any) => {
    const file = e.target.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onloadend = async () => {
      const base64 = reader.result
        ?.toString()
        .split(",")[1];

      setLoading(true);

      const response = await fetch("/api/analyze", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ image: base64 })
      });

      const data = await response.json();

      setResult(data);
      setLoading(false);
    };

    reader.readAsDataURL(file);
  };

  return (
    <div className="min-h-screen p-10">
      <div className="max-w-5xl mx-auto bg-white rounded-2xl shadow-xl p-10">
        <h1 className="text-3xl font-bold mb-6">
          Upload Prescription
        </h1>

        <input
          type="file"
          accept="image/*"
          onChange={handleUpload}
          className="mb-6"
        />

        {loading && (
          <div className="bg-yellow-100 p-4 rounded-xl">
            Analyzing prescription...
          </div>
        )}

        {result && (
          <div className="grid grid-cols-2 gap-6 mt-8">
            <div className="bg-gray-100 p-4 rounded-xl overflow-auto">
              <h2 className="font-bold mb-4">OCR Text</h2>

              <pre>{result.rawText}</pre>
            </div>

            <div className="bg-green-100 p-4 rounded-xl overflow-auto">
              <h2 className="font-bold mb-4">AI Result</h2>

              <pre>
                {JSON.stringify(result.ai, null, 2)}
              </pre>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
